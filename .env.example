# ==========================================
# JVMODAS - CONFIGURAÇÃO DE AMBIENTE (.env.example)
# ==========================================

# 1. Banco de Dados
# Desenvolvimento Local (Zero Config com SQLite):
DATABASE_URL="file:./dev.db"

# Produção (Supabase / PostgreSQL / Neon):
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"

# 2. Segurança do Painel Administrativo (/admin)
ADMIN_PASSWORD="admin123"
ADMIN_SECRET="sua_chave_secreta_longa_e_segura_para_sessao_admin"

# 3. URL Pública da Aplicação
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 4. Gateway de Pagamento (Mercado Pago ou Asaas)
# Opcional: Se vazias, a aplicação roda em modo simulação 100% funcional com QR Code PIX dinâmico
MERCADO_PAGO_ACCESS_TOKEN="APP_USR-..."
MERCADO_PAGO_PUBLIC_KEY="APP_USR-..."
MERCADO_PAGO_WEBHOOK_SECRET="..."
ASAAS_API_KEY="$aact_..."
